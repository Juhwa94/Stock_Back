<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="kr.co.ictedu.projectBack.dao.OrderDao">
	<insert id="addOrderForm" parameterType="ofvo">
		INSERT INTO ORDERFORM (OFNUM,ONAME,OADDR,OPHONE,OFDATE,MNUM,OIMG,OFCOMPANY)
		VALUES (orderform_seq.NEXTVAL, #{oname}, #{oaddr}, #{ophone}, SYSDATE, #{mnum}, #{oimg}, #{ofcompany})
	</insert>
	<insert id="addOrderItem" parameterType="oivo"> 
		INSERT INTO	ORDERITEM (OINUM,OINAME,OIPUBLISHER,OIPRICE,OISUMPRICE,OIAMOUNT,OFNUM) 
		VALUES (orderitem_seq.NEXTVAL, #{oiname}, #{oipublisher}, #{oiprice}, #{oisumprice}, #{oiamount}, #{ofnum})
	</insert>
	<select id="fkSelect" resultType="int">
		SELECT orderform_seq.currVal FROM dual
	</select>
</mapper>